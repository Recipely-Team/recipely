{
  "name": "recipely",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start",
    "android": "expo run:android",
    "android:dev": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=production expo prebuild -p ios --clean && APP_VARIANT=production expo run:ios",
    "ios:dev": "APP_VARIANT=development expo prebuild -p ios --clean && APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "web:dev": "APP_VARIANT=development expo start --web",
    "build:web": "expo export --platform web && node scripts/prune-web-export.mjs dist && node scripts/emit-hosting-404.mjs dist && node scripts/apply-variant-robots.mjs dist && node scripts/prerender-recipes.mjs dist && node scripts/assert-public-assets.mjs dist && node scripts/assert-page-titles.mjs dist && node scripts/assert-csp-inline-scripts.mjs dist",
    "build:web:dev": "APP_VARIANT=development expo export --platform web && node scripts/prune-web-export.mjs dist && node scripts/emit-hosting-404.mjs dist && APP_VARIANT=development node scripts/apply-variant-robots.mjs dist && node scripts/assert-page-titles.mjs dist",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:structure": "node scripts/check-structure.mjs && node scripts/assert-crawlable-surface.mjs && npm run --silent verify:envelope && npm run --silent verify:spotlight",
    "check:structure:ci": "node scripts/check-structure.mjs && node scripts/assert-crawlable-surface.mjs",
    "prepare": "husky",
    "release:patch": "npm version patch -m 'chore(release): v%s' && git push --follow-tags",
    "release:minor": "npm version minor -m 'chore(release): v%s' && git push --follow-tags",
    "release:major": "npm version major -m 'chore(release): v%s' && git push --follow-tags",
    "map": "node scripts/generate-map.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "shortcuts": "node scripts/generate-app-shortcuts.mjs",
    "shortcuts:android": "node scripts/generate-android-shortcuts.mjs",
    "verify:envelope": "bash scripts/verify-swift-envelope.sh",
    "verify:envelope:android": "cd android && ./gradlew :recipely-assistant-kit:testDebugUnitTest",
    "check:secrets": "node scripts/check-release-secrets.mjs",
    "verify:spotlight": "bash scripts/verify-swift-spotlight.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@live-assistant/audio": "0.3.4",
    "@live-assistant/core": "0.3.4",
    "@live-assistant/gemini": "0.3.4",
    "@noble/ciphers": "^2.2.0",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "axios": "^1.7.9",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-share-intent": "^8.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "0.13.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "17.2.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.9",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.7",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^17.0.5",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/dist/"
    ],
    "moduleNameMapper": {
      "^@assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/$1",
      "^@core/(.*)$": "<rootDir>/src/core/$1",
      "^@domain/(.*)$": "<rootDir>/src/domain/$1",
      "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
      "^@application/(.*)$": "<rootDir>/src/application/$1",
      "^@presentation/(.*)$": "<rootDir>/src/presentation/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@noble/.*|standard-navigation))"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/__fixtures__/**",
      "!src/**/__mocks__/**",
      "!src/**/*.d.ts",
      "!src/presentation/i18n/locales/**",
      "!src/presentation/base/test-support/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 62,
        "statements": 61,
        "branches": 54,
        "functions": 53
      },
      "./src/domain/": {
        "lines": 94,
        "statements": 94,
        "branches": 91,
        "functions": 93
      },
      "./src/application/": {
        "lines": 85,
        "statements": 83,
        "branches": 79,
        "functions": 89
      },
      "./src/core/": {
        "lines": 91,
        "statements": 92,
        "branches": 90,
        "functions": 87
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ]
  },
  "private": true,
  "overrides": {
    "shell-quote": "^1.11.0",
    "@grpc/grpc-js": "^1.14.5",
    "source-map-js": "^1.2.2"
  }
}
