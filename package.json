{
  "name": "recipely",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start",
    "android": "expo run:android",
    "android:dev": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=production expo prebuild -p ios --clean && APP_VARIANT=production expo run:ios",
    "ios:dev": "APP_VARIANT=development expo prebuild -p ios --clean && APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "web:dev": "APP_VARIANT=development expo start --web",
    "build:web": "expo export --platform web && node scripts/prune-web-export.mjs dist && node scripts/apply-variant-robots.mjs dist",
    "build:web:dev": "APP_VARIANT=development expo export --platform web && node scripts/prune-web-export.mjs dist && APP_VARIANT=development node scripts/apply-variant-robots.mjs dist",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:structure": "node scripts/check-structure.mjs",
    "prepare": "husky",
    "release:patch": "npm version patch -m 'chore(release): v%s' && git push --follow-tags",
    "release:minor": "npm version minor -m 'chore(release): v%s' && git push --follow-tags",
    "release:major": "npm version major -m 'chore(release): v%s' && git push --follow-tags",
    "map": "node scripts/generate-map.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^2.2.0",
    "@react-native-firebase/analytics": "^24.0.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-firebase/crashlytics": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "axios": "^1.7.9",
    "expo": "^55.0.28",
    "expo-apple-authentication": "~55.0.15",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-build-properties": "~55.0.16",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.17",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-share-intent": "^6.1.1",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.20",
    "expo-video": "~55.0.19",
    "expo-web-browser": "~55.0.18",
    "firebase": "^12.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "sharp": "^0.34.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "lint-staged": "^17.0.5",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "moduleNameMapper": {
      "^@assets/(.*)$": "<rootDir>/assets/$1",
      "^@core/(.*)$": "<rootDir>/src/core/$1",
      "^@domain/(.*)$": "<rootDir>/src/domain/$1",
      "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
      "^@application/(.*)$": "<rootDir>/src/application/$1",
      "^@presentation/(.*)$": "<rootDir>/src/presentation/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ]
  },
  "private": true
}
