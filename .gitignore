# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
# A worktree left a node_modules SYMLINK in a commit once: the pattern above
# ends in a slash, which matches a directory but not a link of the same name.
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase config (contains client API keys — injected from CI secrets)
google-services.json
GoogleService-Info.plist
GoogleService-Info.dev.plist

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# A local Expo module builds in place, and the two entries above are
# root-anchored — they never reached `modules/*/android/`, so a single
# `assembleDebug` committed 174 jars, class files and dex outputs.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
modules/*/ios/build/

# Claude Code
.claude/

# Local Claude Code agent memory (per-user, not project state).
memory/

# Local, machine-specific release/push helper scripts (per-user, not project state).
git_push.applescript
recipely_push.command
