<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Declared in the library manifest rather than injected by the config
      plugin: Gradle merges it into the app, and a service that ships with the
      code that implements it cannot fall out of step with it.
    -->
    <service
      android:name="net.recipely.assistantkit.RecipelyAssistantTileService"
      android:exported="true"
      android:icon="@drawable/recipely_tile_assistant"
      android:label="@string/recipely_shortcut_askRecipely"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <!--
      A button, not a data surface: `updatePeriodMillis` is 0 because there is
      nothing to refresh, and a widget that never refreshes cannot go stale.
    -->
    <receiver
      android:name="net.recipely.assistantkit.RecipelyAssistantWidget"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/recipely_assistant_widget_info" />
    </receiver>
  </application>
</manifest>
