{
  "name": "@live-assistant/token-server",
  "version": "0.1.0",
  "description": "Server-side helper that mints short-lived Gemini Live tokens with your system instruction, tools and voice baked in, so the API key never reaches a device.",
  "license": "MIT",
  "author": "Recep Tayyip Ekşi",
  "keywords": [
    "gemini",
    "gemini-live",
    "ephemeral-token",
    "server",
    "node",
    "ai"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!src/**/__tests__"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@live-assistant/core": "0.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
