{
  "name": "@live-assistant/widget",
  "version": "0.1.0",
  "description": "A ready-made voice assistant UI for React Native and the web: an orb that moves with the voices, a transcript and controls, themed and worded by the app. Built only on @live-assistant/react's public hooks.",
  "license": "MIT",
  "author": "Recep Tayyip Ekşi",
  "keywords": [
    "react-native",
    "ui",
    "voice-assistant",
    "widget",
    "orb",
    "realtime"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!src/**/__tests__"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@live-assistant/core": "0.1.0",
    "@live-assistant/react": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  }
}
