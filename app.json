{
  "expo": {
    "name": "Recipely",
    "slug": "recipely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F5F4",
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:recipely.net"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EE8941",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "recipely.net"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "infoPlist": {
              "NSAllowsArbitraryLoads": true
            },
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBAuth",
              "RNFBCrashlytics"
            ]
          },
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "extraProguardRules": "# expo-modules-core converts JS option objects into @Field-annotated Kotlin\n# Record classes (e.g. SecureStoreOptions) via kotlin-reflect at runtime. R8\n# full-mode optimization (proguard-android-optimize.txt) rewrites the reflection\n# helpers this relies on, so SecureStore.getItemAsync(key) throws \"cannot be cast\n# to type SecureStoreOptions (received ReadableNativeMap)\". expo ships a keep for\n# Record subclasses but not for the converter machinery — keep both.\n-keep class expo.modules.kotlin.records.** { *; }\n-keep class expo.modules.kotlin.types.** { *; }\n-keep class kotlin.Metadata { *; }\n-keep class kotlin.reflect.jvm.internal.** { *; }\n-keepattributes RuntimeVisibleAnnotations,RuntimeVisibleParameterAnnotations,AnnotationDefault,Signature,InnerClasses,EnclosingMethod,Metadata"
          }
        }
      ],
      [
        "expo-router",
        {
          "root": "src/presentation/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F4",
          "dark": {
            "backgroundColor": "#F5F5F4"
          }
        }
      ],
      "expo-localization",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Recipely uses your microphone so you can talk to the cooking assistant.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/sounds/alarm.mp3"
          ],
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Recipely accesses your photos to add them to recipes.",
          "cameraPermission": "Recipely accesses your camera to take photos and videos for recipes."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/auth",
      "expo-apple-authentication",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.421167568469-hl9tkgpi61p1rrir349b9ild9h976kgd"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork",
