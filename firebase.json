            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
            },
            {
